# Zona Audio · Supabase
# Copia este archivo como .env.local y completa los valores.
# No subas .env.local a Git ni compartas la service role en el navegador.

NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU_CLAVE_ANON
SUPABASE_SERVICE_ROLE_KEY=TU_CLAVE_SERVICE_ROLE

# Correo(s) autorizado(s) para entrar a /admin.
ADMIN_EMAIL=tu-correo@ejemplo.com
# Si hay varios administradores, sepáralos por comas.
ADMIN_EMAILS=
